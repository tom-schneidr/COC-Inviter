<Window x:Class="COCInviter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:properties="clr-namespace:COCInviter.Properties"
        mc:Ignorable="d"
        Title="CoC Inviter" Height="480" Width="830">
    <TabControl>
        <TabItem Header="Players">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="74.276" />
                    <ColumnDefinition Width="525.724"/>
                    <ColumnDefinition Width="225" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Height="475" Width="600" VerticalAlignment="Top" HorizontalAlignment="Left" Grid.ColumnSpan="2">
                    <DataGrid x:Name="PlayerTable" AutoGenerateColumns="False" AlternatingRowBackground="Transparent"
                    HorizontalGridLinesBrush="Black" VerticalGridLinesBrush="Black" CanUserAddRows="False">
                        <DataGrid.Resources>
                            <Style x:Key="CustomRowStyle" TargetType="{x:Type DataGridRow}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Black"/>
                                <Style.Triggers>
                                    <Trigger Property="AlternationIndex" Value="1">
                                        <Setter Property="Background" Value="Gainsboro"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Townhall" Binding="{Binding Townhall}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Queen" Binding="{Binding Queen}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="King" Binding="{Binding King}" Width="45" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Warden" Binding="{Binding Warden}" Width="55" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Champion" Binding="{Binding Champion}" Width="65" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Attacks" Binding="{Binding Attacks}" Width="50" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Trophies" Binding="{Binding Trophies}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Donations" Binding="{Binding Donations}" Width="80" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <Grid Grid.Column="2" Height="475" Width="225" HorizontalAlignment="Center" VerticalAlignment="Top" Background="WhiteSmoke">
                    <Label Content="Invite Stats" HorizontalAlignment="Center" Margin="0,5,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20"/>

                    <Line X1="0" Y1="50" X2="225" Y2="50" Stroke="Black" StrokeThickness="2" />

                    <Label x:Name="TotalPlayersFoundText" Content="Total players found: 0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,55, 0, 0" FontSize="15"/>
                    <Label x:Name="TotalPlayersInvitedText" Content="Total players invited: 0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,85, 0, 0" FontSize="15"/>

                    <Line X1="0" Y1="125" X2="225" Y2="125" Stroke="Black" StrokeThickness="1" />

                    <Label x:Name="SessionPlayersFoundText" Content="Session players found: 0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,135, 0, 0" FontSize="15"/>
                    <Label x:Name="SessionPlayersInvitedText" Content="Session players invited: 0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,165, 0, 0" FontSize="15"/>

                    <Line X1="0" Y1="205" X2="225" Y2="205" Stroke="Black" StrokeThickness="1" />

                    <Label x:Name="PlayersToInviteText" Content="Players to invite: 0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,215, 0, 0" FontSize="15"/>
                    <Label x:Name="EstimatedTimeLeftText" Content="Estimated invite time: 0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,245, 0, 0" FontSize="15"/>

                    <Line X1="0" Y1="285" X2="225" Y2="285" Stroke="Black" StrokeThickness="2" />
                    <Label Content="Controls" HorizontalAlignment="Center" Margin="0,285,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="20"/>
                    <Line X1="0" Y1="320" X2="225" Y2="320" Stroke="Black" StrokeThickness="2" />

                    <CheckBox x:Name="FindPlayersCheckBox" Content="Find players [F9]" FontSize="15" VerticalContentAlignment="Center" VerticalAlignment="Top" Margin="5, 330, 0, 0" Checked="FindPlayersCheckBox_Checked"/>
                    <CheckBox x:Name="InvitePlayersCheckBox"  Content="Invite players [F10]" FontSize="15" VerticalContentAlignment="Center" VerticalAlignment="Top" Margin="5, 360, 0, 0" Checked="InvitePlayersCheckBox_Checked"/>
                    <Button Content="Reset players" FontSize="15" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="20, 390, 0, 0" Click="ResetButton_Click"/>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="Settings">
            <Grid>
                <Label Content="Max League" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,5, 0, 0" FontSize="15"/>
                <ComboBox x:Name="MaxLeagueComboBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 10, 10, 10" SelectionChanged="MaxLeagueComboBox_SelectionChanged">
                    <ComboBoxItem>Bronze III</ComboBoxItem>
                    <ComboBoxItem>Bronze II</ComboBoxItem>
                    <ComboBoxItem>Bronze I</ComboBoxItem>
                    <ComboBoxItem>Silver III</ComboBoxItem>
                    <ComboBoxItem>Silver II</ComboBoxItem>
                    <ComboBoxItem>Silver I</ComboBoxItem>
                    <ComboBoxItem>Gold III</ComboBoxItem>
                    <ComboBoxItem>Gold II</ComboBoxItem>
                    <ComboBoxItem>Gold I</ComboBoxItem>
                    <ComboBoxItem>Crystal III</ComboBoxItem>
                    <ComboBoxItem>Crystal II</ComboBoxItem>
                    <ComboBoxItem>Crystal I</ComboBoxItem>
                    <ComboBoxItem>Master III</ComboBoxItem>
                    <ComboBoxItem>Master II</ComboBoxItem>
                    <ComboBoxItem>Master I</ComboBoxItem>
                    <ComboBoxItem>Champion III</ComboBoxItem>
                    <ComboBoxItem>Champion II</ComboBoxItem>
                    <ComboBoxItem>Champion I</ComboBoxItem>
                </ComboBox>
                <Label Content="Min Townhall" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,35, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinTownhallTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 35, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="Min Level" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,65, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinLevelTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 65, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="Min Attacks" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,95, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinAttacksTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 95, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="Min King" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,125, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinKingTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 125, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="Min Queen" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,155, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinQueenTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 155, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="Min Warden" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,185, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinWardenTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 185, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="Min Champion" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,215, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinChampionTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 215, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="Min Trophies" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,245, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinTrophiesTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 245, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="Min Donations" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,275, 0, 0" FontSize="15"/>
                <TextBox x:Name="MinDonationsTextBox" Width="100" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 275, 0, 0" FontSize="15" PreviewTextInput="TextBox_PreviewTextInput"/>

                <Label Content="API-KEY" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5,305, 0, 0" FontSize="15"/>
                <TextBox x:Name="ApiKeyTextBox" Width="500" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="110, 305, 0, 0" FontSize="15" TextChanged="ApiKeyTextBox_TextChanged"/>

                <Label Content="Acceptable roles:" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="250, 5, 0, 0" FontSize="15"/>
                <ListBox x:Name="RolesBox"  SelectionMode="Multiple" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="380, 5, 0, 0"
                 SelectionChanged="RolesBox_SelectionChanged">
                    <ListBoxItem>Leader</ListBoxItem>
                    <ListBoxItem>CoLeader</ListBoxItem>
                    <ListBoxItem>Elder</ListBoxItem>
                    <ListBoxItem>Member</ListBoxItem>
                </ListBox>
            </Grid>
        </TabItem>

    </TabControl>
</Window>
